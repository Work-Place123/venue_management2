generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model packages {
  id               Int      @id @default(autoincrement())
  name             String?  @db.VarChar(255)
  price            String?  @db.VarChar(50)
  description      String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(0)
  event_category   String?  @db.VarChar(100)
  package_type     String?  @db.VarChar(100)
  package_features String?  @db.Text
  venue_type       String?  @db.VarChar(100)
  image_url        String?  @db.VarChar(255)
}

model venues {
  id          Int      @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  city        String?  @db.VarChar(100)
  category    String?  @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
}

model photos {
  id          Int      @id @default(autoincrement())
  title       String?  @db.VarChar(255)
  caption     String?  @db.VarChar(255)
  altText     String?  @db.VarChar(255)
  description String?  @db.Text
  filePath    String?  @db.VarChar(255)
  related     String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
}

model manualBooking {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  email            String    @db.VarChar(255)
  phone            String    @db.VarChar(20)
  eventDate        DateTime  @db.DateTime(0)
  venueType        String    @db.VarChar(100)
  numberOfGuests   Int
  useCustomPlanner Boolean   @default(false)
  packageId        Int?
  customServices   String?   @db.Text
  customPrice      Float?    @db.Float
  paymentStatus    String    @db.VarChar(50)
  paymentMethod    String    @db.VarChar(50)
  specialRequests  String?   @db.Text
  createdAt        DateTime? @default(now()) @db.DateTime(0)
}
